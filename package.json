{
  "name": "tether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test:runtime": "node scripts/check-runtime.mjs",
    "test:command": "node scripts/check-command.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:interactions": "node scripts/check-interactions.mjs",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:environments": "node scripts/check-environments.mjs"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.4",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "ssh2": "1.17.0"
  }
